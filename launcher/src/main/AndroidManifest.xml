<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed on Android 11+ to see / launch the Minecraft package. -->
    <queries>
        <package android:name="com.mojang.minecraftpe" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="Mobile Client"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- The launcher itself must not get the in-game overlay. -->
        <meta-data
            android:name="mobileclient.auto_attach"
            android:value="false"
            tools:replace="android:value" />

        <activity
            android:name=".LauncherActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
